rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Content release audio recordings and anatomical diagrams
    match /content-releases/{releaseId}/{allPaths=**} {
      // Authenticated trainees can stream stethoscope recordings and view diagrams
      allow read: if request.auth != null;
      
      // Only authorized administrators or ingestion pipelines can upload content assets
      allow write: if request.auth != null && (
        request.auth.token.role in ['CONTENT_ADMIN', 'PLATFORM_ADMIN']
      );
    }

    // Default deny for all unspecified paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
