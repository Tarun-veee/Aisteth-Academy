# ==============================================================================
# AiSteth Academy — Client Environment Configuration Template
# ==============================================================================
# Copy this file to .env.development or .env.local to configure your local setup.
# NOTE: All variables prefixed with VITE_ are embedded into the client bundle.
# NEVER place server secrets, Admin SDK keys, or private keys in this file!
# ==============================================================================

# Target Firebase Cloud Project
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Client Application Runtime Settings
VITE_APP_ENV=development
VITE_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_APP_VERSION=1.0.0
